<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <!-- illusionlive.com brand #353958 fills the header band; the shell below it is white -->
        <item name="android:colorAccent">#757DBD</item>
        <item name="android:colorPrimary">#353958</item>
        <item name="android:statusBarColor">#353958</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <!-- the status bar sits on the navy band, so its icons stay light -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 27+; silently ignored on API 26 -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
