<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>IllusionLiveNotifier</AssemblyName>
    <RootNamespace>IllusionLiveNotifier</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\board-colors.json" LogicalName="board-colors.json" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
  </ItemGroup>
</Project>
